{
  "name": "@ansvar/croatian-law-mcp",
  "version": "1.0.0",
  "mcpName": "eu.ansvar/croatian-law-mcp",
  "description": "Croatian law database covering data protection, cybersecurity, e-commerce, and criminal law provisions via Model Context Protocol",
  "author": "Ansvar Systems <hello@ansvar.eu>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ansvar-Systems/Croatian-law-mcp.git"
  },
  "homepage": "https://ansvar.eu",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "croatian-law",
    "data-protection",
    "gdpr",
    "cybersecurity",
    "legislation",
    "legal",
    "compliance",
    "ansvar"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "croatian-law-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data/database.db",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "build:db": "node --import tsx scripts/build-db.ts",
    "dev": "node --import tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ingest": "node --import tsx scripts/ingest.ts",
    "verify:upstream": "node --import tsx scripts/verify-upstream.ts",
    "catalog:build-csv": "node --import tsx scripts/build-catalog-from-csv.ts",
    "catalog:crawl": "node --import tsx scripts/crawl-nn-law-catalog.ts",
    "catalog:ingest": "node --import tsx scripts/ingest-catalog.ts",
    "catalog:sync-fast": "npm run catalog:build-csv && npm run catalog:ingest",
    "test:contract": "vitest run __tests__/contract/",
    "drift:detect": "node --import tsx scripts/drift-detect.ts",
    "validate": "npm run lint && npm test && npm run test:contract",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "postinstall": "test -d dist || npm run build || true",
    "ingest:fetch": "tsx scripts/ingest-fetch.ts",
    "ingest:diff": "tsx scripts/ingest-diff.ts",
    "coverage:update": "tsx scripts/update-coverage.ts",
    "freshness:check": "tsx scripts/check-freshness.ts",
    "coverage:verify": "tsx scripts/verify-coverage.ts",
    "ingest:full": "npm run ingest:fetch && npm run build:db && npm run coverage:update"
  },
  "dependencies": {
    "@ansvar/mcp-sqlite": "^1.0.3",
    "@modelcontextprotocol/sdk": "^1.25.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.29",
    "better-sqlite3": "^12.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "path-to-regexp": "^8.0.0",
    "undici": "^7.0.0",
    "ajv": "^8.18.0",
    "minimatch": ">=10.2.3",
    "smol-toml": ">=1.6.1"
  }
}
